# Anthropic API key — powers the AI plush finder (web search).
# Get one at https://console.anthropic.com/ . SERVER-ONLY: never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — accounts + cloud database for collections.
# Project Settings -> API in your Supabase dashboard.
# These two are safe to expose to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: which Claude model the finder uses.
# One of: claude-sonnet-5 (default), claude-opus-4-8, claude-haiku-4-5
FINDER_MODEL=claude-sonnet-5
